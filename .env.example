# Production (main → www.saltguide.co.uk)
# NEXT_PUBLIC_SITE_URL=https://www.saltguide.co.uk
# NEXT_PUBLIC_APP_ENV=production

# Staging (staging branch → staging.saltguide.co.uk)
NEXT_PUBLIC_SITE_URL=https://staging.saltguide.co.uk
NEXT_PUBLIC_APP_ENV=staging

# Supabase — required at BUILD time for Cloudflare Pages (static export inlines
# NEXT_PUBLIC_* into the JS bundle). Set the same two values for BOTH:
#   Cloudflare Pages → Settings → Environment variables → Production
#   Cloudflare Pages → Settings → Environment variables → Preview
# Preview-only vars will make staging work and www fall back to venues.json
# (no listing photos). After changing vars, Retry the Production deployment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
