# Production (main → www.saltguide.co.uk)
# NEXT_PUBLIC_SITE_URL=https://www.saltguide.co.uk
# NEXT_PUBLIC_APP_ENV=production

# Staging (staging branch → staging.saltguide.co.uk)
NEXT_PUBLIC_SITE_URL=https://staging.saltguide.co.uk
NEXT_PUBLIC_APP_ENV=staging

# Supabase — required at BUILD time (static export inlines NEXT_PUBLIC_*).
# Use the full URL including https://, and the FULL anon JWT (three parts
# separated by dots) or an sb_publishable_ key. A host-only URL or the first
# JWT segment alone will ship a site with no live listings.
#
# Set the same two names in BOTH of these places (they do not share values):
#   1. Cloudflare Pages → Settings → Environment variables
#      Production AND Preview, as Build variables (not runtime-only Worker secrets).
#      Then Retry the Production deployment.
#   2. GitHub → Settings → Secrets and variables → Actions
#      NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
#      (used only by GitHub Actions CI; Cloudflare git builds cannot see these.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
