# Production (main branch) — optional; these are the defaults in code.
# NEXT_PUBLIC_SITE_URL=https://www.saltguide.co.uk
# NEXT_PUBLIC_APP_ENV=production

# Staging (staging branch) — set in Cloudflare Pages → Preview environment variables.
NEXT_PUBLIC_SITE_URL=https://staging.saltguide.co.uk
NEXT_PUBLIC_APP_ENV=staging

# Supabase — staging uses the Saltguide project (show_on_saltguide flags).
# Set the same values in Cloudflare Pages → Preview env vars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
